# OIDA-Bibliothek: Fenster, Zeichnen, Tasten und Maus.     BRAUCH fensta OIDA
#
# So schaut ein Programm mit Fenster aus:
#
#     BRAUCH fensta OIDA
#     fensta_auf("Mei Spü", 800, 600) OIDA
#     SOLONG fensta_offn() TUA
#         foab(20, 20, 40) OIDA
#         hintagrund() OIDA
#         foab(255, 200, 0) OIDA
#         kreis(maus_x(), maus_y(), 30) OIDA
#     PASST SCHO
#
# fensta_offn() zeigt, was seit dem letzten Mal gezeichnet wurde, und beginnt
# ein neues Bild. Es gibt FOISCH zurück, sobald jemand das Fenster zumacht.
#
# Der Punkt (0, 0) ist links oben, x geht nach rechts, y nach unten. Eine
# Einheit ist ein Bildpunkt. Winkel sind im Bogenmaß (siehe in_bogn in mathe).

# ---------------------------------------------------------------- das Fenster

FUNKTIAUN fensta_auf(titl KETTN, breite ZOI, höhe ZOI) VON DRAUSSN "oida_g_auf" OIDA
FUNKTIAUN fensta_offn() GIBT ZRUCK JONA VON DRAUSSN "oida_g_offen" OIDA
# Macht das Fenster zu: Das nächste fensta_offn() gibt FOISCH zurück.
FUNKTIAUN fensta_zua() VON DRAUSSN "oida_g_zu" OIDA
FUNKTIAUN fensta_breite() GIBT ZRUCK ZOI VON DRAUSSN "oida_g_breite" OIDA
FUNKTIAUN fensta_höhe() GIBT ZRUCK ZOI VON DRAUSSN "oida_g_hoehe" OIDA

# Sekunden, seit das Fenster aufgegangen ist.
FUNKTIAUN zeit() GIBT ZRUCK KOMMAZOI VON DRAUSSN "oida_g_zeit" OIDA
# Sekunden, die das letzte Bild gedauert hat. Damit rechnet man Bewegungen:
# x += tempo * büd_zeit()  ist auf jedem Rechner gleich schnell.
FUNKTIAUN büd_zeit() GIBT ZRUCK KOMMAZOI VON DRAUSSN "oida_g_bild_zeit" OIDA

# ---------------------------------------------------------------------- Farbe

# Die Farbe für alles, was danach gezeichnet wird: rot, grün, blau, je 0 bis 255.
FUNKTIAUN foab(rot ZOI, grün ZOI, blau ZOI) VON DRAUSSN "oida_g_farbe" OIDA
# Wie im Web: foab_hex("#ff8800"), kurz "#f80", mit Deckung "#ff880080".
FUNKTIAUN foab_hex(code KETTN) VON DRAUSSN "oida_g_farbe_hex" OIDA
# 1 ist ganz deckend, 0 unsichtbar. Gilt, bis man es wieder ändert.
FUNKTIAUN deckung(wert KOMMAZOI) VON DRAUSSN "oida_g_deckung" OIDA

# -------------------------------------------- Farbverläufe, Mischen, Leuchten
# Statt einer Farbe ein Übergang: zuerst sagen, von wo nach wo, dann die
# Farben entlang des Wegs (0 ist der Anfang, 1 das Ende). Gilt, bis wieder
# foab() oder foab_hex() kommt.
#
#     valauf_grod(0, 0, 0, 100) OIDA                  # von oben nach unten
#     valauf_foab(0, "#33ccff", 1) OIDA
#     valauf_foab(1, "#33ccff", 0) OIDA               # unten durchsichtig
#     rechteck(0, 0, 200, 100) OIDA
FUNKTIAUN valauf_grod(x1 KOMMAZOI, y1 KOMMAZOI, x2 KOMMAZOI, y2 KOMMAZOI) VON DRAUSSN "oida_g_verlauf_gerade" OIDA
# Von der Mitte (x, y) nach außen, vom inneren zum äußeren Radius.
FUNKTIAUN valauf_rund(x KOMMAZOI, y KOMMAZOI, innen KOMMAZOI, außn KOMMAZOI) VON DRAUSSN "oida_g_verlauf_rund" OIDA
FUNKTIAUN valauf_foab(stö KOMMAZOI, hex KETTN, deckung KOMMAZOI) VON DRAUSSN "oida_g_verlauf_stufe" OIDA

FUNKTIAUN mischn_roh(hell JONA) VON DRAUSSN "oida_g_mischen" OIDA

# Ab jetzt werden Farben zusammengezählt statt übereinandergelegt: Wo sich
# zwei Lichter treffen, wird es heller. Gilt bis mischn_normal() oder bis zum nächsten Bild.
FUNKTIAUN mischn_dazua()
    mischn_roh(WOAHR) OIDA
PASST SCHO

FUNKTIAUN mischn_normal()
    mischn_roh(FOISCH) OIDA
PASST SCHO

# Alles, was ab jetzt gezeichnet wird, bekommt einen weichen Schein: so weit,
# in dieser Farbe, so deckend. Gilt bis leuchtn_aus() oder bis zum nächsten Bild.
FUNKTIAUN leuchtn(weitn KOMMAZOI, hex KETTN, deckung KOMMAZOI) VON DRAUSSN "oida_g_leuchten" OIDA

FUNKTIAUN leuchtn_aus()
    leuchtn(0, "#000000", 0) OIDA
PASST SCHO

# ------------------------------------------------------------------- Zeichnen

# Füllt das ganze Fenster mit der aktuellen Farbe.
FUNKTIAUN hintagrund() VON DRAUSSN "oida_g_hintergrund" OIDA
# (x, y) ist die linke obere Ecke.
FUNKTIAUN rechteck(x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI) VON DRAUSSN "oida_g_rechteck" OIDA
FUNKTIAUN rechteck_rand(x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI, dicke KOMMAZOI) VON DRAUSSN "oida_g_rechteck_rand" OIDA
FUNKTIAUN rechteck_rund(x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI, radius KOMMAZOI) VON DRAUSSN "oida_g_rechteck_rund" OIDA
FUNKTIAUN rechteck_rund_rand(x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI, radius KOMMAZOI, dicke KOMMAZOI) VON DRAUSSN "oida_g_rechteck_rund_rand" OIDA
# (x, y) ist die Mitte.
FUNKTIAUN ellipsn(x KOMMAZOI, y KOMMAZOI, radius_x KOMMAZOI, radius_y KOMMAZOI) VON DRAUSSN "oida_g_ellipse" OIDA
FUNKTIAUN kreis_rand(x KOMMAZOI, y KOMMAZOI, radius KOMMAZOI, dicke KOMMAZOI) VON DRAUSSN "oida_g_kreis_rand" OIDA
FUNKTIAUN linie(x1 KOMMAZOI, y1 KOMMAZOI, x2 KOMMAZOI, y2 KOMMAZOI, dicke KOMMAZOI) VON DRAUSSN "oida_g_linie" OIDA
# Eine gefüllte Form durch die Punkte x, y, x, y ...: vieleck([0.0, 0.0, 50.0, 0.0, 25.0, 40.0])
FUNKTIAUN vieleck(punkte LISTN VON KOMMAZOI) VON DRAUSSN "oida_g_vieleck" OIDA
# Linien von Punkt zu Punkt; mit zua = WOAHR zurück zum ersten.
FUNKTIAUN linienzug(punkte LISTN VON KOMMAZOI, dicke KOMMAZOI, zua JONA) VON DRAUSSN "oida_g_linienzug" OIDA
# Ein Stück Kreislinie zwischen zwei Winkeln (0 zeigt nach rechts, weiter im Uhrzeigersinn).
FUNKTIAUN bogn(x KOMMAZOI, y KOMMAZOI, radius KOMMAZOI, von_winkl KOMMAZOI, bis_winkl KOMMAZOI, dicke KOMMAZOI) VON DRAUSSN "oida_g_bogen" OIDA

# Ränder und Linien sind ab jetzt gestrichelt: so lang der Strich, so lang die Lücke.
FUNKTIAUN gstrichlt(strich KOMMAZOI, lückn KOMMAZOI) VON DRAUSSN "oida_g_strich" OIDA

# ... und ab jetzt wieder durchgezogen.
FUNKTIAUN durchzogn()
    gstrichlt(0, 0) OIDA
PASST SCHO

# --- Freie Formen aus Linien und Kurven: erst bauen, dann füllen und/oder umranden.
#
#     form_anfang() OIDA
#     form_geh(0, 8) OIDA
#     form_kurvn3(-13, -2, -6, -11, 0, -4) OIDA       # ein Herz
#     form_kurvn3(6, -11, 13, -2, 0, 8) OIDA
#     form_fülln() OIDA
FUNKTIAUN form_anfang() VON DRAUSSN "oida_g_form_anfang" OIDA
# Hierhin, ohne zu zeichnen: Ein neuer Teil der Form beginnt.
FUNKTIAUN form_geh(x KOMMAZOI, y KOMMAZOI) VON DRAUSSN "oida_g_form_geh" OIDA
FUNKTIAUN form_linie(x KOMMAZOI, y KOMMAZOI) VON DRAUSSN "oida_g_form_linie" OIDA
# Eine Kurve nach (x, y), die sich zum Punkt (zx, zy) hin biegt.
FUNKTIAUN form_kurvn(zx KOMMAZOI, zy KOMMAZOI, x KOMMAZOI, y KOMMAZOI) VON DRAUSSN "oida_g_form_kurve" OIDA
# Eine Kurve nach (x, y) mit zwei Punkten, zu denen sie sich biegt.
FUNKTIAUN form_kurvn3(z1x KOMMAZOI, z1y KOMMAZOI, z2x KOMMAZOI, z2y KOMMAZOI, x KOMMAZOI, y KOMMAZOI) VON DRAUSSN "oida_g_form_kurve3" OIDA
# Ein Stück Kreis um (x, y) zwischen zwei Winkeln.
FUNKTIAUN form_bogn(x KOMMAZOI, y KOMMAZOI, radius KOMMAZOI, von_winkl KOMMAZOI, bis_winkl KOMMAZOI) VON DRAUSSN "oida_g_form_bogen" OIDA
# Zurück zum Anfang dieses Teils.
FUNKTIAUN form_zua() VON DRAUSSN "oida_g_form_zu" OIDA
FUNKTIAUN form_fülln() VON DRAUSSN "oida_g_form_fuellen" OIDA
FUNKTIAUN form_rand(dicke KOMMAZOI) VON DRAUSSN "oida_g_form_rand" OIDA

# --- Ausschnitte: Ab jetzt wird nur innerhalb der Form gezeichnet, bis ausschnitt_aus() kommt.
FUNKTIAUN ausschnitt_rechteck(x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI) VON DRAUSSN "oida_g_ausschnitt_rechteck" OIDA
FUNKTIAUN ausschnitt_rund(x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI, radius KOMMAZOI) VON DRAUSSN "oida_g_ausschnitt_rund" OIDA
FUNKTIAUN ausschnitt_kreis(x KOMMAZOI, y KOMMAZOI, radius KOMMAZOI) VON DRAUSSN "oida_g_ausschnitt_kreis" OIDA
FUNKTIAUN ausschnitt_aus() VON DRAUSSN "oida_g_ausschnitt_aus" OIDA

FUNKTIAUN kreis(x KOMMAZOI, y KOMMAZOI, radius KOMMAZOI)
    ellipsn(x, y, radius, radius) OIDA
PASST SCHO

FUNKTIAUN dreieck(x1 KOMMAZOI, y1 KOMMAZOI, x2 KOMMAZOI, y2 KOMMAZOI, x3 KOMMAZOI, y3 KOMMAZOI)
    vieleck([x1, y1, x2, y2, x3, y3]) OIDA
PASST SCHO

# ----------------------------------------------------------------------- Text

FUNKTIAUN schrift_roh(größe KOMMAZOI, fett JONA) VON DRAUSSN "oida_g_schrift" OIDA
FUNKTIAUN text_roh(x KOMMAZOI, y KOMMAZOI, inhalt KETTN, ausrichtung ZOI) VON DRAUSSN "oida_g_text" OIDA

# Die Schrift für alles, was danach geschrieben wird. Die Größe ist die Höhe in Bildpunkten.
FUNKTIAUN schrift(größe KOMMAZOI)
    schrift_roh(größe, FOISCH) OIDA
PASST SCHO

FUNKTIAUN schrift_fett(größe KOMMAZOI)
    schrift_roh(größe, WOAHR) OIDA
PASST SCHO

# Schreibt so, dass (x, y) die linke obere Ecke vom Text ist.
FUNKTIAUN text_links(x KOMMAZOI, y KOMMAZOI, inhalt KETTN)
    text_roh(x, y, inhalt, 0) OIDA
PASST SCHO

# Schreibt so, dass (x, y) die Mitte vom Text ist.
FUNKTIAUN text_mittig(x KOMMAZOI, y KOMMAZOI, inhalt KETTN)
    text_roh(x, y, inhalt, 1) OIDA
PASST SCHO

# Schreibt so, dass (x, y) die rechte obere Ecke vom Text ist.
FUNKTIAUN text_rechts(x KOMMAZOI, y KOMMAZOI, inhalt KETTN)
    text_roh(x, y, inhalt, 2) OIDA
PASST SCHO

# Der Text fängt bei x an, y ist seine halbe Höhe (gut neben einem Balken oder Bild).
FUNKTIAUN text_links_mitte(x KOMMAZOI, y KOMMAZOI, inhalt KETTN)
    text_roh(x, y, inhalt, 3) OIDA
PASST SCHO

# Der Text hört bei x auf, y ist seine halbe Höhe.
FUNKTIAUN text_rechts_mitte(x KOMMAZOI, y KOMMAZOI, inhalt KETTN)
    text_roh(x, y, inhalt, 4) OIDA
PASST SCHO

# Der Text steht mittig über dem Punkt (x, y).
FUNKTIAUN text_drüba(x KOMMAZOI, y KOMMAZOI, inhalt KETTN)
    text_roh(x, y, inhalt, 5) OIDA
PASST SCHO

# Der Text hängt mittig unter dem Punkt (x, y).
FUNKTIAUN text_drunta(x KOMMAZOI, y KOMMAZOI, inhalt KETTN)
    text_roh(x, y, inhalt, 6) OIDA
PASST SCHO

# Wie breit der Text in der aktuellen Schrift wird (zum Umbrechen oder für einen Rahmen darum).
FUNKTIAUN text_breite(inhalt KETTN) GIBT ZRUCK KOMMAZOI VON DRAUSSN "oida_g_text_breite" OIDA

# --------------------------------------------------------------------- Bilder
# Ein Bild aus einer Datei (PNG, JPG, BMP, GIF) oder ein leeres zum Hineinzeichnen.
STRUKTUR Büd
    numma ZOI
    breite ZOI
    höhe ZOI
PASST SCHO

FUNKTIAUN büd_roh_lodn(pfad KETTN) GIBT ZRUCK ZOI VON DRAUSSN "oida_g_bild_laden" OIDA
FUNKTIAUN büd_roh_fehla() GIBT ZRUCK KETTN VON DRAUSSN "oida_g_bild_fehler" OIDA
FUNKTIAUN büd_roh_neich(breite ZOI, höhe ZOI) GIBT ZRUCK ZOI VON DRAUSSN "oida_g_bild_neu" OIDA
FUNKTIAUN büd_roh_breite(numma ZOI) GIBT ZRUCK ZOI VON DRAUSSN "oida_g_bild_breite" OIDA
FUNKTIAUN büd_roh_höhe(numma ZOI) GIBT ZRUCK ZOI VON DRAUSSN "oida_g_bild_hoehe" OIDA
FUNKTIAUN büd_roh_moi(numma ZOI, x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI) VON DRAUSSN "oida_g_bild" OIDA
FUNKTIAUN büd_roh_stickl(numma ZOI, qx KOMMAZOI, qy KOMMAZOI, qb KOMMAZOI, qh KOMMAZOI, x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI) VON DRAUSSN "oida_g_bild_teil" OIDA
FUNKTIAUN büd_roh_ziel(numma ZOI) VON DRAUSSN "oida_g_bild_ziel" OIDA
FUNKTIAUN büd_roh_laar(numma ZOI) VON DRAUSSN "oida_g_bild_leeren" OIDA
FUNKTIAUN büd_roh_weg(numma ZOI) VON DRAUSSN "oida_g_bild_weg" OIDA

# Liest ein Bild aus einer Datei. Das Fenster muss dafür schon offen sein.
FUNKTIAUN lod_büd(pfad KETTN) GIBT ZRUCK Büd ODA FEHLA
    SOG AU numma = büd_roh_lodn(pfad) OIDA
    WENN numma < 0 DAUN
        GIB ZRUCK FEHLA(pfad + ": " + büd_roh_fehla()) OIDA
    PASST SCHO
    GIB ZRUCK Büd(numma, büd_roh_breite(numma), büd_roh_höhe(numma)) OIDA
PASST SCHO

# Ein leeres, durchsichtiges Bild. Mit moi_in() zeichnet man hinein.
FUNKTIAUN neichs_büd(breite ZOI, höhe ZOI) GIBT ZRUCK Büd
    GIB ZRUCK Büd(büd_roh_neich(breite, höhe), breite, höhe) OIDA
PASST SCHO

# Legt das Bild in seiner eigenen Größe hin; (x, y) ist die linke obere Ecke.
FUNKTIAUN moi_büd(b Büd, x KOMMAZOI, y KOMMAZOI)
    büd_roh_moi(b.numma, x, y, b.breite, b.höhe) OIDA
PASST SCHO

# ... oder in das Rechteck gestreckt.
FUNKTIAUN moi_büd_groß(b Büd, x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI)
    büd_roh_moi(b.numma, x, y, breite, höhe) OIDA
PASST SCHO

# Nur das Stück (qx, qy, qb, qh) vom Bild, in das Rechteck (x, y, breite, höhe) gelegt.
FUNKTIAUN moi_büd_stickl(b Büd, qx KOMMAZOI, qy KOMMAZOI, qb KOMMAZOI, qh KOMMAZOI, x KOMMAZOI, y KOMMAZOI, breite KOMMAZOI, höhe KOMMAZOI)
    büd_roh_stickl(b.numma, qx, qy, qb, qh, x, y, breite, höhe) OIDA
PASST SCHO

# Ab jetzt landet alles Gezeichnete in diesem Bild (einem von neichs_büd)
# statt im Fenster. Gut für etwas Aufwendiges, das sich nicht ändert: einmal
# hineinzeichnen, dann in jedem Bild nur noch hinlegen.
FUNKTIAUN moi_in(b Büd)
    büd_roh_ziel(b.numma) OIDA
PASST SCHO

# ... und ab jetzt wieder ins Fenster.
FUNKTIAUN moi_ins_fensta()
    büd_roh_ziel(-1) OIDA
PASST SCHO

# Macht ein Bild zum Hineinzeichnen wieder ganz durchsichtig.
FUNKTIAUN büd_laar(b Büd)
    büd_roh_laar(b.numma) OIDA
PASST SCHO

# Gibt das Bild her. Danach darf man es nicht mehr verwenden.
FUNKTIAUN büd_weg(b Büd)
    büd_roh_weg(b.numma) OIDA
PASST SCHO

# Vergrößerte Bilder weich zeichnen (WOAHR, so fängt es an) oder mit sichtbaren Kästchen (FOISCH).
FUNKTIAUN büd_glott(jo JONA) VON DRAUSSN "oida_g_bild_glatt" OIDA

# ------------------------------------------- verschieben, drehen, vergrößern

# Alles, was danach gezeichnet wird, ist um (dx, dy) verschoben. So macht man
# eine Kamera: schiab(-kamera_x, -kamera_y), dann die Welt zeichnen.
FUNKTIAUN schiab(dx KOMMAZOI, dy KOMMAZOI) VON DRAUSSN "oida_g_schieb" OIDA
# Dreht um den Punkt (0, 0); vorher dorthin schieben, worum sich etwas drehen soll.
FUNKTIAUN drah(winkl KOMMAZOI) VON DRAUSSN "oida_g_dreh" OIDA
FUNKTIAUN vergrößa(faktor KOMMAZOI) VON DRAUSSN "oida_g_gross" OIDA
# Merkt sich, wie gerade verschoben, gedreht und vergrößert ist ...
FUNKTIAUN lage_merkn() VON DRAUSSN "oida_g_lage_merken" OIDA
# ... und stellt es wieder her. Mit jedem neuen Bild ist alles wieder gerade.
FUNKTIAUN lage_zruck() VON DRAUSSN "oida_g_lage_zurueck" OIDA

# ------------------------------------------------------------ Tasten und Maus

# Ist die Taste gerade gedrückt? Namen: ein Buchstabe oder eine Ziffer ("A", "7"),
# "LINKS", "RECHTS", "AUFFE", "OBE", "LAA" (Leertaste), "ENTER", "ESC", "SHIFT",
# "STRG", "ALT", "TAB", "ZRUCK", "F1" bis "F12".
FUNKTIAUN taste(name KETTN) GIBT ZRUCK JONA VON DRAUSSN "oida_g_taste" OIDA
# Ist die Taste seit dem letzten Bild neu gedrückt worden? (Für "einmal schießen pro Druck".)
FUNKTIAUN taste_neich(name KETTN) GIBT ZRUCK JONA VON DRAUSSN "oida_g_taste_neu" OIDA
FUNKTIAUN maus_x() GIBT ZRUCK KOMMAZOI VON DRAUSSN "oida_g_maus_x" OIDA
FUNKTIAUN maus_y() GIBT ZRUCK KOMMAZOI VON DRAUSSN "oida_g_maus_y" OIDA
# Knopf 1 ist links, 2 rechts, 3 die Mitte.
FUNKTIAUN maus_taste(knopf ZOI) GIBT ZRUCK JONA VON DRAUSSN "oida_g_maus" OIDA
FUNKTIAUN maus_taste_neich(knopf ZOI) GIBT ZRUCK JONA VON DRAUSSN "oida_g_maus_neu" OIDA
# Wie viele Rasten das Mausrad seit dem letzten Bild gedreht wurde (nach unten positiv, wie im Browser).
FUNKTIAUN maus_radl() GIBT ZRUCK KOMMAZOI VON DRAUSSN "oida_g_maus_rad" OIDA
