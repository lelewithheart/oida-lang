# RogueWave: die Verbesserungen, aus denen man bei jedem Stufenaufstieg wählt.

BRAUCH "spü.oida" OIDA

# Was eine Verbesserung tut, steht als Funktion dabei.
STRUKTUR Vabessarung
    kennung KETTN
    nam KETTN
    büdl KETTN
    waffn JONA
    # Ein Satz dazu, oder "" (bei "pierce" wird er beim Zeichnen ausgerechnet).
    wos KETTN
    wirkung FUNKTIAUN(Spü)
PASST SCHO

FUNKTIAUN olle_vabessarungen() GIBT ZRUCK LISTN VON Vabessarung
    GIB ZRUCK [
        # Werte der Spielfigur
        Vabessarung("dmg1", "+5 Damage", "⚔️", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.schodn += 5),
        Vabessarung("dmg2", "+10 Damage", "🗡️", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.schodn += 10),
        Vabessarung("spd1", "+15% Move Speed", "👟", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.tempo *= 1.15),
        Vabessarung("spd2", "+25% Move Speed", "💨", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.tempo *= 1.25),
        Vabessarung("rate1", "+20% Fire Rate", "🔫", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.schuss_pause *= 0.80),
        Vabessarung("rate2", "+35% Fire Rate", "💥", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.schuss_pause *= 0.65),
        Vabessarung("hp1", "+25 Max HP", "❤️", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.mehr_lebn(25)),
        Vabessarung("hp2", "+50 Max HP", "💖", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.mehr_lebn(50)),
        Vabessarung("heal", "Heal 30%", "🩹", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.heil(0.3)),
        Vabessarung("magnet", "+XP Magnet Range", "🧲", FOISCH, "", FUNKTIAUN(s Spü) => s.magnet += 40),
        Vabessarung("armor1", "+3 Armor", "🛡️", FOISCH, "Reduces all damage taken by 3", FUNKTIAUN(s Spü) => s.spiela.rüstung += 3),
        Vabessarung("armor2", "+6 Armor", "🏰", FOISCH, "Reduces all damage taken by 6", FUNKTIAUN(s Spü) => s.spiela.rüstung += 6),
        Vabessarung("regen1", "+2 HP/sec Regen", "💚", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.heilung += 2),
        Vabessarung("regen2", "+5 HP/sec Regen", "🌿", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.heilung += 5),
        Vabessarung("pierce", "Piercing +1", "📌", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.durchschuss += 1),
        Vabessarung("multi", "+1 Multi-Shot", "🎯", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.mehrschuss += 1),
        Vabessarung("crit1", "+10% Crit Chance", "🎲", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.mehr_glück(0.10)),
        Vabessarung("crit2", "+0.5x Crit Damage", "💎", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.glück_moi += 0.5),
        Vabessarung("bigBullet", "+30% Bullet Size", "⭕", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.schuss_größe *= 1.3),
        Vabessarung("range1", "+20% Range", "📡", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.reichweite *= 1.20),
        Vabessarung("range2", "+40% Range", "🔭", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.reichweite *= 1.40),
        Vabessarung("xpgain1", "+25% XP Gain", "✨", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.xp_moi *= 1.25),
        Vabessarung("xpgain2", "+50% XP Gain", "⭐", FOISCH, "", FUNKTIAUN(s Spü) => s.spiela.xp_moi *= 1.50),

        # Waffen
        Vabessarung("orbit", "Orbit Shield +1", "🔵", WOAHR, "", FUNKTIAUN(s Spü) => s.spiela.schüd_stufn += 1),
        Vabessarung("lightning", "Lightning Aura +1", "⚡", WOAHR, "", FUNKTIAUN(s Spü) => s.spiela.blitz_stufn += 1),
        Vabessarung("frost", "Frost Nova +1", "❄️", WOAHR, "", FUNKTIAUN(s Spü) => s.spiela.frost_stufn += 1),
        Vabessarung("flame", "Flame Trail +1", "🔥", WOAHR, "", FUNKTIAUN(s Spü) => s.spiela.feia_stufn += 1)
    ] OIDA
PASST SCHO

# Für die Anzeige rechts unten: Verbesserungen derselben Art teilen sich ein Bild.
STRUKTUR Gruppn
    büdl KETTN
    kennungen LISTN VON KETTN
PASST SCHO

FUNKTIAUN olle_gruppn() GIBT ZRUCK LISTN VON Gruppn
    GIB ZRUCK [
        Gruppn("⚔️", ["dmg1", "dmg2"]),
        Gruppn("👟", ["spd1", "spd2"]),
        Gruppn("🔫", ["rate1", "rate2"]),
        Gruppn("❤️", ["hp1", "hp2"]),
        Gruppn("🛡️", ["armor1", "armor2"]),
        Gruppn("💚", ["regen1", "regen2"]),
        Gruppn("📌", ["pierce"]),
        Gruppn("🎯", ["multi"]),
        Gruppn("🎲", ["crit1", "crit2"]),
        Gruppn("⭕", ["bigBullet"]),
        Gruppn("📡", ["range1", "range2"]),
        Gruppn("🧲", ["magnet"]),
        Gruppn("✨", ["xpgain1", "xpgain2"])
    ] OIDA
PASST SCHO
