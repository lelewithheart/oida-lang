FIX GEDRÄNGE_OBN = 26 OIDA
FIX GEDRÄNGE_PAUSE = 0.12 OIDA          # höchstens alle so viele Sekunden kommt einer nach
FIX GEDRÄNGE_ANFANG = 10 OIDA           # so viele kommen am Anfang jeder Welle auf einmal
