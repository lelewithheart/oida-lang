# ------------------------------------------------------------------ Helfer

# Zufällige Kommazahl von `untn` bis unter `obn`.
FUNKTIAUN zufoi_von(untn KOMMAZOI, obn KOMMAZOI) GIBT ZRUCK KOMMAZOI
    GIB ZRUCK untn + ZUFOI() * (obn - untn) OIDA
PASST SCHO

# Sekunden als MM:SS
FUNKTIAUN zeit_text(sekundn KOMMAZOI) GIBT ZRUCK KETTN
    SOG AU gaunz = ZOI(OBRUNDN(sekundn)) OIDA
    GIB ZRUCK vuan_auffülln(KETTN(gaunz / 60), 2, "0") + ":" + vuan_auffülln(KETTN(gaunz % 60), 2, "0") OIDA
PASST SCHO

# Der Name der Spielart für die Anzeige.
FUNKTIAUN modus_nam(modus KETTN) GIBT ZRUCK KETTN
    WENN modus == "easy" DAUN
        GIB ZRUCK "EASY" OIDA
    PASST SCHO
    WENN modus == "hard" DAUN
        GIB ZRUCK "HARD" OIDA
    PASST SCHO
    GIB ZRUCK "NORMAL" OIDA
PASST SCHO

# Wie weit der Punkt (px, py) von der Strecke a-b weg ist.
FUNKTIAUN obstand_zua_streckn(px KOMMAZOI, py KOMMAZOI, ax KOMMAZOI, ay KOMMAZOI, bx KOMMAZOI, by KOMMAZOI) GIBT ZRUCK KOMMAZOI
    SOG AU vx = bx - ax OIDA
    SOG AU vy = by - ay OIDA
    SOG AU läng = vx * vx + vy * vy OIDA
    WENN läng == 0 DAUN
        läng = 1.0 OIDA
    PASST SCHO
    SOG AU t = GRÖSSTA(0.0, KLANSTA(1.0, ((px - ax) * vx + (py - ay) * vy) / läng)) OIDA
    SOG AU dx = px - (ax + vx * t) OIDA
    SOG AU dy = py - (ay + vy * t) OIDA
    GIB ZRUCK WURZL(dx * dx + dy * dy) OIDA
PASST SCHO

# Was die Spielart ändert: leichter, gewöhnlich oder härter.
STRUKTUR Spüoat
    tote_moi KOMMAZOI           # wie viele Treffer eine Welle braucht
    pause_moi KOMMAZOI          # Pause zwischen neuen Gegnern
    lebn_moi KOMMAZOI
    tempo_moi KOMMAZOI
    schodn_moi KOMMAZOI
    xp_moi KOMMAZOI
    xp_wochstum KOMMAZOI        # um so viel wächst der Bedarf für die nächste Stufe
    rast_moi KOMMAZOI
    bsundare_moi KOMMAZOI       # wie oft besondere Gegner kommen
PASST SCHO

FUNKTIAUN spüoat_von(modus KETTN) GIBT ZRUCK Spüoat
    WENN modus == "easy" DAUN
        GIB ZRUCK Spüoat(0.78, 1.25, 0.8, 0.82, 0.8, 1.9, 1.10, 1.12, 0.9) OIDA
    PASST SCHO
    WENN modus == "hard" DAUN
        GIB ZRUCK Spüoat(1.35, 0.72, 1.3, 1.28, 1.35, 0.72, 1.12, 0.85, 1.25) OIDA
    PASST SCHO
    GIB ZRUCK Spüoat(1, 1, 1, 1, 1, 1, 1.10, 1, 1) OIDA
PASST SCHO

# Die drei Gebiete: alle paar Wellen sieht die Welt anders aus.
STRUKTUR Gebiet
    nam KETTN
    grund KETTN
    gitta KETTN
    rand KETTN
PASST SCHO

FUNKTIAUN gebiet_von(numma ZOI) GIBT ZRUCK Gebiet
    WENN numma % 3 == 1 DAUN
        GIB ZRUCK Gebiet("Acid Grid", "#131b17", "#1d3a2c", "#66ff99") OIDA
    PASST SCHO
    WENN numma % 3 == 2 DAUN
        GIB ZRUCK Gebiet("Crimson Core", "#1d1016", "#3a1d28", "#ff6688") OIDA
    PASST SCHO
    GIB ZRUCK Gebiet("Neon District", "#101226", "#1a2448", "#33ccff") OIDA
PASST SCHO

# Wie viele Wellen über die letzte hinaus (0 im gewöhnlichen Spiel).
FUNKTIAUN endlos_tiafn(wön ZOI) GIBT ZRUCK ZOI
    GIB ZRUCK GRÖSSTA(0, wön - WÖN_LETZTE) OIDA
PASST SCHO

# Mit der Welle werden Ankündigung und Pause der Boss-Angriffe etwas kürzer, höchstens um ein gutes Drittel.
FUNKTIAUN boss_tempo(wön ZOI) GIBT ZRUCK KOMMAZOI
    GIB ZRUCK GRÖSSTA(0.65, KLANSTA(1.0, 1 - (wön - 5) * 0.015)) OIDA
PASST SCHO

# Der Grundwert für den Schaden der Boss-Angriffe; jeder Angriff nimmt einen Teil davon.
FUNKTIAUN boss_angriff_grund(wön ZOI) GIBT ZRUCK ZOI
    GIB ZRUCK BOSS_ANGRIFF_GRUND + wön * BOSS_ANGRIFF_PRO_WÖN OIDA
PASST SCHO
