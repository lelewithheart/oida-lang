STRUKTUR Punkt
    x KOMMAZOI
    y KOMMAZOI
PASST SCHO

SOG AU nam = "Hansi" OIDA
SOG AU punkte = 1200 OIDA
SOG AU preis = 3.14159 OIDA
SOG AU p = Punkt(1.5, -2) OIDA
SOG AU sochn = ["Schwert", "Schüd"] OIDA

SCHREIB($"Servas {nam}, du host {punkte} Punkte!") OIDA
SCHREIB($"{nam}{punkte}", $"", $"nur Text", $'einfache {nam}') OIDA
SCHREIB($"Des mocht {preis:2} Euro, grundt {preis:0}, genau {preis}.") OIDA
SCHREIB($"Rechnen: {punkte * 2 + 1}, Vergleich: {punkte > 1000}, Föd: {p.x}, Stö: {sochn[1]}, Läng: {LÄNGN(sochn)}") OIDA
SCHREIB($"Klammern: {{so}} und {{{nam}}}, Zeile\tmit Tab und \"Anführung\"") OIDA
SCHREIB($"Text drin: {"a" + 'b'}, gschachtelt: {$"[{nam}]"}, Funktion: {SCHREI(nam)}, ODA HOID: {ZOI AUS("x") ODA HOID -1}") OIDA
SCHREIB($"{punkte:2} {7:3} {2.5:0} {3.5:0} {-0.004:2}") OIDA
SCHREIB(LÄNGN($"{nam}!"), $"a" + $"b{1}" == "ab1") OIDA
SCHREIB(AUF STÖN(2, 3), AUF STÖN(1 / 3.0, 4), AUF STÖN(1e9, 0), AUF STÖN(-1.005, 1)) OIDA

SCHREIB(1_000_000, 0xFF, 0x7fff_ffff, 0b1010, 1e3, 2.5e-3, 1E6, 1_0.5_0, 6.02e23) OIDA
SOG AU auf = 5 OIDA
SOG AU e = 2 OIDA
SCHREIB(auf + e, 1 + e) OIDA
FIA i VON 1 BIS 3 TUA
    SCHREIB($"{i}. Durchgang von {3}") OIDA
PASST SCHO
