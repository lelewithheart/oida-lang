STRUKTUR Punkt
    x ZOI
PASST SCHO
KLASSE Wesen
    name KETTN
    FUNKTIAUN sog() GIBT ZRUCK KETTN
        GIB ZRUCK SÖWA.name OIDA
    PASST SCHO
PASST SCHO
KLASSE Gegner ERBT VON Wesen
    FUNKTIAUN sog() GIBT ZRUCK KETTN
        SOG AU f = FUNKTIAUN() => DE OIDN.sog() OIDA
        GIB ZRUCK f() OIDA
    PASST SCHO
PASST SCHO
FUNKTIAUN doppelt(x ZOI) GIBT ZRUCK ZOI
    GIB ZRUCK x * 2 OIDA
PASST SCHO
FUNKTIAUN griaß(wen KETTN)
PASST SCHO
FUNKTIAUN zwamoi(f FUNKTIAUN(ZOI) GIBT ZRUCK ZOI, x ZOI) GIBT ZRUCK ZOI
    GIB ZRUCK f(f(x)) OIDA
PASST SCHO
SOG AU zahl = 5 OIDA
zahl(1) OIDA
SOG AU f = doppelt OIDA
SCHREIB(f(1, 2)) OIDA
SCHREIB(f("ans")) OIDA
SCHREIB(zwamoi(griaß, 3)) OIDA
SCHREIB(zwamoi(FUNKTIAUN(x KOMMAZOI) => x, 3)) OIDA
f = griaß OIDA
SOG AU zöh = FUNKTIAUN() => zahl += 1 OIDA
SOG AU p = Punkt(1) OIDA
SOG AU schiab = FUNKTIAUN()
    p.x = 5 OIDA
    zahl = 7 OIDA
PASST SCHO OIDA
SOG AU hoib = FUNKTIAUN(x ZOI) GIBT ZRUCK ZOI
    WENN x > 2 DAUN
        GIB ZRUCK x / 2 OIDA
    PASST SCHO
PASST SCHO OIDA
SOG AU offen = FUNKTIAUN() => NIX OIDA
SOG AU fremd = FUNKTIAUN() => gibts_ned + 1 OIDA
SOG AU vf VIELLEICHT FUNKTIAUN(ZOI) GIBT ZRUCK ZOI = NIX OIDA
SCHREIB(vf(1)) OIDA
SCHREIB(f == f) OIDA
SCHREIB(doppelt(1)(2)) OIDA
