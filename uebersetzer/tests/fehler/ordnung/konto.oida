KLASSE Konto
    inhaba KETTN
    GHEIM stand ZOI = 0

    GHEIM FUNKTIAUN prüf(betrog ZOI) GIBT ZRUCK ZOI
        GIB ZRUCK betrog OIDA
    PASST SCHO
PASST SCHO

# Auch wer von der Klasse erbt, kommt nicht an das GHEIME.
KLASSE Kind ERBT VON Konto
    FUNKTIAUN schau() GIBT ZRUCK ZOI
        GIB ZRUCK MEI.stand + MEI.prüf(1) OIDA
    PASST SCHO
PASST SCHO

GHEIM STRUKTUR Zettl
    text KETTN
PASST SCHO

# In einer Meldung heißt auch etwas mit GHEIM so, wie es dasteht.
GHEIM FUNKTIAUN hüf(n ZOI) GIBT ZRUCK ZOI
    GIB ZRUCK n OIDA
PASST SCHO

FUNKTIAUN braucht_hüf() GIBT ZRUCK ZOI
    GIB ZRUCK hüf("ans") OIDA
PASST SCHO
