FUNKTIAUN teil(a ZOI, b ZOI) GIBT ZRUCK ZOI ODA FEHLA
    WENN b == 0 DAUN
        GIB ZRUCK "geht ned" OIDA
    PASST SCHO
    GIB ZRUCK a / b OIDA
PASST SCHO
FUNKTIAUN speicher() GIBT ZRUCK NIX ODA FEHLA
    GIB ZRUCK 5 OIDA
PASST SCHO
FUNKTIAUN ohne() GIBT ZRUCK ZOI
    SOG AU x = PROBIER teil(1, 2) OIDA
    GIB ZRUCK x OIDA
PASST SCHO
FUNKTIAUN mit() GIBT ZRUCK ZOI ODA FEHLA
    SOG AU y = PROBIER 5 OIDA
    SCHREIB(PROBIER teil(1, 2)) OIDA
    GIB ZRUCK teil(3, 4) + 1 OIDA
PASST SCHO
teil(1, 2) OIDA
SOG AU e = teil(1, 2) OIDA
SCHREIB(e + 1) OIDA
SOG AU haupt = PROBIER teil(1, 2) OIDA
PROBIER x = speicher()
WONNS SCHIEFGEHT f
    SCHREIB(f.code) OIDA
PASST SCHO
PROBIER x = 7
WONNS SCHIEFGEHT
PASST SCHO
SCHREIB(speicher() ODA HOID 0) OIDA
SOG AU doppelt FEHLA ODA FEHLA = FEHLA("a") OIDA
SOG AU f FEHLA = 5 OIDA
SCHREIB(ZOI AUS(5), ZOI AUS()) OIDA
