KLASSE Wesen
    name KETTN
    ziel VIELLEICHT Wesen = NIX
    FUNKTIAUN sog() GIBT ZRUCK KETTN
        GIB ZRUCK SÖWA.ziel.name OIDA
    PASST SCHO
PASST SCHO
FUNKTIAUN such(n ZOI) GIBT ZRUCK VIELLEICHT Wesen
    GIB ZRUCK NIX OIDA
PASST SCHO
SOG AU w = such(1) OIDA
SCHREIB(w.name) OIDA
SCHREIB(w.sog()) OIDA
SCHREIB(such(2).name) OIDA
SOG AU z VIELLEICHT ZOI = 5 OIDA
z = NIX OIDA
SCHREIB(z + 1) OIDA
SOG AU fest ZOI = z OIDA
SOG AU offen = NIX OIDA
SOG AU zahl = 3 OIDA
WENN zahl == NIX DAUN
PASST SCHO
zahl = NIX OIDA
SCHREIB(zahl ODA HOID 4) OIDA
SCHREIB(z ODA HOID "vier") OIDA
SOG AU doppelt VIELLEICHT VIELLEICHT ZOI = NIX OIDA
WENN w != NIX DAUN
    w = such(3) OIDA
    SCHREIB(w.name) OIDA
PASST SCHO
SOLONG w != NIX TUA
    SCHREIB(w.name) OIDA
    w = such(4) OIDA
    SCHREIB(w.name) OIDA
PASST SCHO
WENN w != NIX ODA zahl > 1 DAUN
    SCHREIB(w.name) OIDA
PASST SCHO
WENN w != NIX DAUN
    FIA i VON 1 BIS 3 TUA
        SCHREIB(w.name) OIDA
        w = NIX OIDA
    PASST SCHO
PASST SCHO
SCHREIB(NIX == NIX) OIDA
SCHREIB(w == zahl) OIDA
