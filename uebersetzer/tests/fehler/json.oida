STRUKTUR Punkt
    x KOMMAZOI
    y KOMMAZOI
PASST SCHO
KLASSE Viech
    nam KETTN
PASST SCHO
STRUKTUR Stoi
    viecha LISTN VON Viech
PASST SCHO
STRUKTUR Knopf
    drucka FUNKTIAUN(ZOI) GIBT ZRUCK ZOI
PASST SCHO
SOG AU p = Punkt(1, 2) OIDA
SCHREIB(OIS JSON(Viech("Bello"))) OIDA
SCHREIB(OIS JSON(Stoi([]))) OIDA
SCHREIB(OIS JSON(VAZEICHNIS VON ZOI UND KETTN())) OIDA
SCHREIB(OIS JSON(FUNKTIAUN(x ZOI) => x + 1)) OIDA
SCHREIB(OIS JSON()) OIDA
SCHREIB(OIS JSON(p, p)) OIDA
SCHREIB(OIS JSON([])) OIDA
SCHREIB(OIS JSON(NIX)) OIDA
SCHREIB(OIS SCHEES JSON(Viech("Bello"))) OIDA
SOG AU a = AUS JSON VON Viech("{}") OIDA
SOG AU b = AUS JSON VON Punkt(5) OIDA
SOG AU c = AUS JSON VON Gibtsned("{}") OIDA
SOG AU d = AUS JSON VON Knopf("{}") OIDA
SOG AU e Punkt = AUS JSON VON Punkt("{}") OIDA
SCHREIB(AUS JSON VON Punkt("{}").x) OIDA
SOG AU h ZOI = OIS JSON(p) OIDA
