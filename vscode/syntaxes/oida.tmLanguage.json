{
  "//": "Erzeugt mit: oida --editor-dateien <ordner>. Nicht von Hand ändern.",
  "name": "OIDA",
  "scopeName": "source.oida",
  "patterns": [
    { "name": "comment.block.oida", "begin": "/\\*", "end": "\\*/" },
    {
      "name": "string.quoted.double.oida", "begin": "\"", "end": "\"|$",
      "patterns": [ { "name": "constant.character.escape.oida", "match": "\\\\." } ]
    },
    {
      "name": "string.quoted.single.oida", "begin": "'", "end": "'|$",
      "patterns": [ { "name": "constant.character.escape.oida", "match": "\\\\." } ]
    },
    { "name": "comment.line.number-sign.oida", "match": "#.*$" },
    { "name": "constant.numeric.oida", "match": "(?<![\\p{L}\\p{N}_])\\d+(?:\\.\\d+)?" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])PASST\\s+SCHO(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])GIBT\\s+ZRUCK(?![\\p{L}\\p{N}_])" },
    { "name": "constant.language.boolean.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])STIMMT\\s+NED(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])GIB\\s+ZRUCK(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])SOG\\s+AU(?![\\p{L}\\p{N}_])" },
    { "name": "entity.name.type.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])WOAHRFOISCH(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])DEKLARIER(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])FUNKTIAUN(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])ANSUNSTN(?![\\p{L}\\p{N}_])" },
    { "name": "constant.language.boolean.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])SCHMARRN(?![\\p{L}\\p{N}_])" },
    { "name": "entity.name.type.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])KOMMAZOI(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])SCHREIB(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])SOLONG(?![\\p{L}\\p{N}_])" },
    { "name": "constant.language.boolean.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])STIMMT(?![\\p{L}\\p{N}_])" },
    { "name": "constant.language.boolean.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])FOISCH(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])SUNST(?![\\p{L}\\p{N}_])" },
    { "name": "constant.language.boolean.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])WOAHR(?![\\p{L}\\p{N}_])" },
    { "name": "entity.name.type.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])KETTN(?![\\p{L}\\p{N}_])" },
    { "name": "entity.name.type.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])TEXTL(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.other.endwort.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])OIDA(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])WENN(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])WAUN(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])DAUN(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])MOCH(?![\\p{L}\\p{N}_])" },
    { "name": "entity.name.type.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])JONA(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])TUA(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])UND(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])ODA(?![\\p{L}\\p{N}_])" },
    { "name": "keyword.control.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])NED(?![\\p{L}\\p{N}_])" },
    { "name": "entity.name.type.oida", "match": "(?i)(?<![\\p{L}\\p{N}_])ZOI(?![\\p{L}\\p{N}_])" },
    { "name": "entity.name.function.oida", "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()" },
    { "name": "variable.other.readwrite.oida", "match": "[\\p{L}_][\\p{L}\\p{N}_]*" },
    { "name": "keyword.operator.oida", "match": "==|!=|<>|<=|>=|[-+*/%=<>]" }
  ]
}
