{
  "//": "Erzeugt mit: oida --editor-dateien <ordner>. Nicht von Hand ändern.",
  "WENN": {
    "prefix": "wenn",
    "body": ["WENN ${1:bedingung} DAUN", "\t$0", "PASST SCHO"],
    "description": "Verzweigung"
  },
  "WENN SUNST": {
    "prefix": "wennsunst",
    "body": ["WENN ${1:bedingung} DAUN", "\t$2", "SUNST", "\t$0", "PASST SCHO"],
    "description": "Verzweigung mit Sonst-Teil"
  },
  "SOLONG": {
    "prefix": "solong",
    "body": ["SOLONG ${1:bedingung} TUA", "\t$0", "PASST SCHO"],
    "description": "Schleife"
  },
  "FIA": {
    "prefix": "fia",
    "body": ["FIA ${1:i} VON ${2:1} BIS ${3:10} TUA", "\t$0", "PASST SCHO"],
    "description": "Zählschleife"
  },
  "FIA JEDE": {
    "prefix": "fiajede",
    "body": ["FIA JEDE ${1:x} IN ${2:liste} TUA", "\t$0", "PASST SCHO"],
    "description": "Schleife über eine Liste"
  },
  "STRUKTUR": {
    "prefix": "struktur",
    "body": ["STRUKTUR ${1:Name}", "\t${2:feld} ${3:ZOI}", "PASST SCHO"],
    "description": "Struktur mit Feldern"
  },
  "KLASSE": {
    "prefix": "klasse",
    "body": ["KLASSE ${1:Name}", "\t${2:feld} ${3:ZOI}", "", "\tFUNKTIAUN ${4:methode}()", "\t\t$0", "\tPASST SCHO", "PASST SCHO"],
    "description": "Klasse mit einem Feld und einer Methode"
  },
  "KLASSE ERBT VON": {
    "prefix": "klasseerbtvon",
    "body": ["KLASSE ${1:Name} ERBT VON ${2:Eltern}", "\t$0", "PASST SCHO"],
    "description": "Klasse, die von einer anderen erbt"
  },
  "FUNKTIAUN": {
    "prefix": "funktiaun",
    "body": ["FUNKTIAUN ${1:name}(${2:x} ${3:ZOI}) GIBT ZRUCK ${4:ZOI}", "\tGIB ZRUCK ${0:x} OIDA", "PASST SCHO"],
    "description": "Funktion mit Rückgabewert"
  },
  "SOG AU": {
    "prefix": "sogau",
    "body": ["SOG AU ${1:name} = ${2:0} OIDA"],
    "description": "Variable ansagen"
  },
  "SOG AU VIELLEICHT": {
    "prefix": "sogauvielleicht",
    "body": ["SOG AU ${1:name} VIELLEICHT ${2:ZOI} = NIX OIDA"],
    "description": "Variable, in der etwas fehlen darf"
  },
  "WENN != NIX": {
    "prefix": "wennnix",
    "body": ["WENN ${1:name} != NIX DAUN", "\t$0", "PASST SCHO"],
    "description": "Nachschauen, ob etwas da ist"
  },
  "PROBIER": {
    "prefix": "probier",
    "body": ["PROBIER ${1:wert} = ${2:funktion()}", "\t$3", "WONNS SCHIEFGEHT ${4:fehla}", "\t$0", "PASST SCHO"],
    "description": "Etwas probieren und den Fehler auffangen"
  },
  "SCHREIB": {
    "prefix": "schreib",
    "body": ["SCHREIB($1) OIDA"],
    "description": "Ausgabe"
  }
}
