{
  "//": "Erzeugt mit: oida --editor-dateien <ordner>. Nicht von Hand ändern.",
  "comments": { "lineComment": "#", "blockComment": ["/*", "*/"] },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": "*/", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["'", "'"]],
  "wordPattern": { "pattern": "[\\p{L}_][\\p{L}\\p{N}_]*", "flags": "u" },
  "indentationRules": {
    "increaseIndentPattern": { "pattern": "^\\s*(?:(?:FUNKTIAUN|STRUKTUR|KLASSE)(?![\\p{L}\\p{N}_]).*|.*(?<![\\p{L}\\p{N}_])(?:DAUN|MOCH|TUA)|(?:ANSUNSTN|SUNST)|(?:WONNS\\s+SCHIEFGEHT|WENNS\\s+SCHIEFGEHT)(?![\\p{L}\\p{N}_]).*|(?:PROBIERS|PROBIER)(?![\\p{L}\\p{N}_])(?!.*(?<![\\p{L}\\p{N}_])(?:OIDA)\\s*(?:#.*)?$).*|.*(?:[=(,]|(?<![\\p{L}\\p{N}_])(?:GIB\\s+ZRUCK))\\s*(?:FUNKTIAUN)\\s*\\((?!.*=>)(?!.*(?<![\\p{L}\\p{N}_])(?:OIDA)\\s*(?:#.*)?$).*)\\s*(?:#.*)?$", "flags": "iu" },
    "decreaseIndentPattern": { "pattern": "^\\s*(?:(?:PASST\\s+SCHO)|(?:ANSUNSTN|SUNST)|(?:WONNS\\s+SCHIEFGEHT|WENNS\\s+SCHIEFGEHT))(?![\\p{L}\\p{N}_])", "flags": "iu" }
  }
}
