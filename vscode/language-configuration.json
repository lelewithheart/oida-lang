{
  "//": "Erzeugt mit: oida --editor-dateien <ordner>. Nicht von Hand ändern.",
  "comments": { "lineComment": "#", "blockComment": ["/*", "*/"] },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "/*", "close": "*/", "notIn": ["string"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""], ["'", "'"]],
  "wordPattern": { "pattern": "[\\p{L}_][\\p{L}\\p{N}_]*", "flags": "u" },
  "indentationRules": {
    "increaseIndentPattern": { "pattern": "^\\s*(?:(?:FUNKTIAUN|STRUKTUR)(?![\\p{L}\\p{N}_]).*|.*(?<![\\p{L}\\p{N}_])(?:DAUN|MOCH|TUA)|(?:ANSUNSTN|SUNST))\\s*(?:#.*)?$", "flags": "iu" },
    "decreaseIndentPattern": { "pattern": "^\\s*(?:(?:PASST\\s+SCHO)|(?:ANSUNSTN|SUNST))(?![\\p{L}\\p{N}_])", "flags": "iu" }
  }
}
